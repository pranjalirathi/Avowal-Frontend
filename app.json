{
  "expo": {
    "name": "Avowal",
    "slug": "Avowal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avowal.png",
    "userInterfaceStyle": "light",
    "scheme": "avowal",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/avowal.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iprash05.Avowal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/avowal.png",
        "backgroundColor": "#121212"
      },
      "package": "com.iprash05.Avowal"
    },
    "web": {
      "favicon": "./assets/avowal.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "32b30df1-4d17-4d02-a062-a62fd10a74e2"
      }
    }
  }
}
