{
  "expo": {
    "name": "Avowal",
    "slug": "Avowal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avowal.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/avowal.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/avowal.png",
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "favicon": "./assets/avowal.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
